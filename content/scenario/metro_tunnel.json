{
  "id": "metro_tunnel",
  "beats": [
    { "at": 0.5, "do": "cutscene", "id": "intro_blackout" },
    { "at": 7.0, "do": "stat", "key": "panic", "delta": 8 },
    { "at": 7.4, "do": "thought", "id": "dark", "text": "Слишком темно. С этим надо что-то делать.", "until": "has_light" }
  ],
  "triggers": [
    {
      "on": "flag",
      "flag": "has_light",
      "once": true,
      "do": "say",
      "text": "Теперь видно. Остальные гасят экраны, чтобы не слепили."
    },
    {
      "on": "flag",
      "flag": "has_light",
      "once": true,
      "do": "thought",
      "id": "stuffy",
      "text": "Душно. И жарко так, что хочется снять куртку.",
      "until": "window_open"
    },
    {
      "on": "flag",
      "flag": "window_open",
      "once": true,
      "do": "say",
      "text": "Воздух пошёл. Дышать стало легче, и люди затихают."
    },
    {
      "on": "flag",
      "flag": "window_open",
      "once": true,
      "do": "radio",
      "text": "Внимание. Оставайтесь в вагонах.",
      "repeats": 4,
      "interval": 4
    },
    {
      "on": "flag",
      "flag": "cab_open",
      "once": true,
      "do": "thought",
      "id": "cab_empty",
      "text": "Кабина пуста. Дверь наружу распахнута, и из неё тянет холодом.",
      "until": "cab_papered"
    }
  ]
}
