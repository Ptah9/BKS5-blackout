{
  "id": "metro_tunnel",
  "beats": [
    {
      "at": 0.5,
      "do": "cutscene",
      "id": "intro_blackout"
    },
    {
      "at": 7,
      "do": "stat",
      "key": "panic",
      "delta": 8
    },
    {
      "at": 7.4,
      "do": "thought",
      "id": "dark",
      "text": "Слишком темно. С этим надо что-то делать.",
      "until": "has_light"
    },
    {
      "at": 330,
      "do": "thought",
      "id": "flicker",
      "text": "Впереди, в тоннеле, мигает фонарь. Ровно, как будто зовёт.",
      "until": "driver_found"
    }
  ],
  "triggers": [
    {
      "on": "flag",
      "flag": "has_light",
      "once": true,
      "do": "say",
      "text": "Теперь видно. Остальные гасят экраны, чтобы не слепили."
    },
    {
      "on": "flag",
      "flag": "has_light",
      "once": true,
      "do": "thought",
      "id": "stuffy",
      "text": "Душно. И жарко так, что хочется снять куртку.",
      "until": "window_open"
    },
    {
      "on": "flag",
      "flag": "window_open",
      "once": true,
      "do": "say",
      "text": "Воздух пошёл. Дышать стало легче, и люди затихают."
    },
    {
      "on": "flag",
      "flag": "window_open",
      "once": true,
      "do": "radio",
      "text": "Внимание. Оставайтесь в вагонах.",
      "repeats": 4,
      "interval": 5.4
    },
    {
      "on": "flag",
      "flag": "cab_open",
      "once": true,
      "do": "thought",
      "id": "cab_empty",
      "text": "Кабина пуста. Дверь наружу распахнута, и из неё тянет холодом.",
      "until": "cab_papered"
    },
    {
      "on": "flag",
      "flag": "people_ordered",
      "once": true,
      "do": "objective",
      "text": "Провести людей через кабину и вернуться за остальными"
    },
    {
      "on": "flag",
      "flag": "people_crowd",
      "once": true,
      "do": "say",
      "text": "Давка в проёме. Обходчик впервые повышает голос."
    },
    {
      "on": "flag",
      "flag": "ded_helped",
      "once": true,
      "do": "say",
      "text": "Дед катит велосипед рядом и уже не ворчит."
    },
    {
      "on": "flag",
      "flag": "ded_robbed",
      "once": true,
      "do": "say",
      "text": "Дед молчит. В тоннеле он пойдёт за тем, кто говорит уверенно."
    },
    {
      "on": "flag",
      "flag": "red_shirt",
      "once": true,
      "do": "say",
      "text": "Свет стал мягким: глаза привыкли, паника спала."
    },
    {
      "on": "flag",
      "flag": "baba_saved",
      "once": true,
      "do": "say",
      "text": "Бабка сидит и дышит. Полвагона выдохнуло вместе с ней."
    },
    {
      "on": "flag",
      "flag": "girl_calmed",
      "once": true,
      "do": "say",
      "text": "Девочка держит конфету в кулаке и больше не дрожит."
    },
    {
      "on": "flag",
      "flag": "rail_safe",
      "once": true,
      "do": "objective",
      "text": "Вывести всех по цепочке на выход"
    },
    {
      "on": "flag",
      "flag": "people_returned",
      "once": true,
      "do": "say",
      "text": "Голос по громкой связи разворачивает ушедших обратно."
    },
    {
      "on": "flag",
      "flag": "chain_ready",
      "once": true,
      "do": "objective",
      "text": "Цепочка пошла: впереди ты, за тобой дети, старики, остальные"
    },
    {
      "on": "flag",
      "flag": "signal_no_answer",
      "once": true,
      "do": "thought",
      "id": "rail_live",
      "text": "Трубка молчит, значит рельс под напряжением. Мне так сука страшно."
    },
    {
      "on": "flag",
      "flag": "lamp_fake",
      "once": true,
      "do": "say",
      "text": "Мигал не машинист: фонарь у него разбит, а лампа на стене прикручена стяжками."
    },
    {
      "on": "flag",
      "flag": "driver_found",
      "once": true,
      "do": "thought",
      "id": "driver_hurt",
      "text": "Машинист. Нога вывернута, в руке разбитый фонарь — сам он не встанет.",
      "until": "driver_helped"
    },
    {
      "on": "flag",
      "flag": "driver_found",
      "once": true,
      "do": "objective",
      "text": "Помочь машинисту"
    },
    {
      "on": "flag",
      "flag": "driver_helped",
      "once": true,
      "do": "say",
      "text": "Машинист перевязан. Он просит только об одном: не оставлять его тут одного."
    },
    {
      "on": "flag",
      "flag": "driver_splinted",
      "once": true,
      "do": "thought",
      "id": "needs_bandage",
      "text": "Шина держит. Теперь бы перевязать — аптечка осталась в кабине.",
      "until": "driver_helped"
    },
    {
      "on": "flag",
      "flag": "driver_guarded",
      "once": true,
      "do": "say",
      "text": "Обходчик снимает куртку и садится рядом. Дальше ты идёшь один."
    },
    {
      "on": "flag",
      "flag": "driver_guarded",
      "once": true,
      "do": "objective",
      "text": "Искать настоящий выход из тоннеля"
    },
    {
      "on": "flag",
      "flag": "false_exit_seen",
      "once": true,
      "do": "thought",
      "id": "false_exit",
      "text": "Замуровано наглухо: воздух не идёт, сквозняка нет. Это не выход.",
      "until": "chain_ready"
    },
    {
      "on": "flag",
      "flag": "chalk_seen",
      "once": true,
      "do": "say",
      "text": "Те же штрихи, что у стрелки. Кто-то звал сюда нарочно."
    }
  ]
}
