# Скопируй этот файл в .env и впиши значения. Сам .env в git не попадает.
#
# Приоритет мозгов у агентов: локальная модель → DeepSeek → правила.

# Локальная модель на другой машине в локальной сети (см. Flaude/ТЗ_ЛЛМ_МАК.md).
# Пока не задано — используется DeepSeek или правила.
# LOCAL_LLM_URL=http://192.168.0.50:11434
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# LOCAL_LLM_FORMAT=ollama        # ollama | openai

# Ключ DeepSeek — только для разработки диалогов. На демо без интернета он не работает.
DEEPSEEK_API_KEY=
